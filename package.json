{
  "name": "aichat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "all": "concurrently -n fe,be -c cyan,green \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src server --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"server/**/*.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "check": "npm run typecheck && npm run typecheck:server && npm run lint"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.1",
    "chart.js": "^4.5.1",
    "floating-vue": "^5.2.2",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.0.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "vue3-virtual-scroller": "^0.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "postcss": "^8.4.32",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.7.0",
    "vite": "^5.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vue-tsc": "^3.3.7"
  }
}
